# ==============================================================================
# MODO DE EXECUCAO (Mude DRY_RUN=false quando preencher as chaves e aprovar!)
# ==============================================================================
DRY_RUN=true
AUTOPILOT_MODE=semi_auto   # full_auto (posta 100% sozinho nos 5 dias) | semi_auto (pede ok no Telegram p/ fora do padrao)
TIMEZONE=America/Sao_Paulo

# ==============================================================================
# POOL TRI-ENGINE DE IAs (CLAUDE PRO + CODEX PLUS + ANTIGRAVITY ULTRA)
# ==============================================================================
# 1) Antigravity / Gemini Ultra (Carbon = estrategia xhigh | Hydrogen = execucao low)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.5-flash
HYDROGEN_PROVIDER=gemini
HYDROGEN_MODEL=gemini-2.5-flash-lite
CARBON_PROVIDER=gemini
CARBON_MODEL=gemini-2.5-pro

# 2) Claude Pro CLI (Opus xhigh p/ pensar | Haiku/Sonnet low p/ executar + Auto-Resume 5h)
CLAUDE_CLI_ENABLED=true
CLAUDE_CLI_CMD=claude
CLAUDE_THINK_MODEL=opus
CLAUDE_THINK_EFFORT=max
CLAUDE_EXEC_MODEL=haiku
CLAUDE_EXEC_EFFORT=low

# 3) Codex Plus CLI (sol-6.2 xhigh p/ pensar | low p/ executar + Auto-Resume 5h)
CODEX_CLI_ENABLED=true
CODEX_CLI_CMD=codex
CODEX_THINK_MODEL=sol-6.2
CODEX_THINK_EFFORT=xhigh
CODEX_EXEC_MODEL=sol-6.2
CODEX_EXEC_EFFORT=low

# ==============================================================================
# ESCALA 5 CANAIS x 12 VIDEOS/DIA (60/DIA = 300 EM 5 DIAS)
# ==============================================================================
MULTI_CHANNEL_ENABLED=true
CHANNELS_MATRIX_FILE=config/channels_matrix.yaml
VIDEOS_PER_CHANNEL_PER_DAY=12

# ==============================================================================
# CAMPANHA REAL OFICIAL LIVE YOUTUBE x GTA VI (KY4DWumZffg)
# ATENCAO: A campanha paga APENAS TikTok e Instagram (Reels/Carrossel)!
# ==============================================================================
REAL_OFICIAL_ENABLED=true
REAL_OFICIAL_API_KEY=
REAL_OFICIAL_MCP_TOKEN=
REAL_OFICIAL_BASE_URL=https://api.realoficial.com.br
REAL_OFICIAL_CAMPAIGN_SLUG=gta-vi-youtube
REAL_OFICIAL_REF_VID=a56ec50b-725e-4c73-a353-4e3b2e80678b
REAL_OFICIAL_DAILY_CREDIT_LIMIT=150
REAL_OFICIAL_LAUNCHER_ID=
REAL_OFICIAL_LAUNCHER_ID_1=
REAL_OFICIAL_LAUNCHER_ID_2=
REAL_OFICIAL_LAUNCHER_ID_3=
REAL_OFICIAL_LAUNCHER_ID_4=
REAL_OFICIAL_LAUNCHER_ID_5=
REAL_OFICIAL_ALLOW_SPEND_CREDITS=false

# ==============================================================================
# INSTAGRAM GRAPH API & TIKTOK API DIRETA (Plataformas Oficiais da Campanha + Auto-Pin 1o Comentario!)
# ==============================================================================
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
TIKTOK_ACCESS_TOKEN=

# ==============================================================================
# BUFFER / WEBHOOK (Alternativa p/ agendar Reels + TikTok nos 5 canais)
